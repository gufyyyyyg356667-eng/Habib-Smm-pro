<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Play flavor: no accessibility service, no overlay, no QUERY_ALL_PACKAGES -->
    <application>
        <provider
            android:name=".forge.ForgeFileProvider"
            android:authorities="${applicationId}.forge.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/forge_file_paths" />
        </provider>
    </application>
</manifest>
